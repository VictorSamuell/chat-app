{
  "name": "zap-2",
  "version": "2.0.0",
  "description": "Aplicação de chat em tempo real com Node.js e Socket.io",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test",
    "dev:cloudflare": "wrangler dev --port 8787",
    "check:cloudflare": "wrangler deploy --dry-run --outdir .cloudflare-build",
    "deploy:cloudflare": "wrangler deploy",
    "test:cloudflare": "node --test test/cloudflare.test.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "miniflare": "^5.20261118.0-beta",
    "socket.io-client": "^4.8.1",
    "wrangler": "^4.165.0",
    "ws": "^8.23.0"
  },
  "dependencies": {
    "express": "^4.21.2",
    "socket.io": "^4.8.1"
  }
}
