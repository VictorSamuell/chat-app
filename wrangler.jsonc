{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zap-2-chat",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-11-18",
  "workers_dev": true,
  "send_metrics": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": ["/api/*", "/r/*", "/chat", "/"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "ChatRoom" },
      { "name": "GUARD", "class_name": "RequestGuard" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ChatRoom", "RequestGuard"] }
  ],
  "observability": { "enabled": false }
}
